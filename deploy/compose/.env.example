# docker compose environment template — copy to deploy/compose/.env
#
# docker compose auto-loads `.env` from the compose file's directory
# (deploy/compose/.env), so `make dev-up` picks these up automatically.
#
# NEVER commit a real .env. Values below are obviously-fake dev placeholders.

# --- PostgreSQL (control plane) ---
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=ai_gateway

# --- Redis (provisioned; consumed once the Redis milestone lands) ---
REDIS_PASSWORD=change-me

# --- Control-plane session signing (postgres + control-api require >= 32 bytes) ---
# Generate a real one with:  openssl rand -hex 32
AUTH_HMAC_SIGNING_KEY=change-me-change-me-change-me-change-me