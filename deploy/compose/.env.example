# docker compose environment template — copy to deploy/compose/.env
#
# docker compose auto-loads `.env` from the compose file's directory
# (deploy/compose/.env), so `make dev-up` picks these up automatically.
#
# NEVER commit a real .env. Values below are obviously-fake dev placeholders.
# For staging/production, generate strong unique secrets (e.g. openssl rand -hex 32).

# --- Environment Mode & Development Safety Guardrails ---
AIGW_ENV=development
# Explicitly allow dev-only conveniences (placeholder secrets, dev login, unencrypted cookies).
# If set to false, or if AIGW_ENV is production/staging, placeholders and bypasses are rejected at startup.
AIGW_ALLOW_INSECURE_DEV=true

# --- PostgreSQL (control plane) ---
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=ai_gateway

# --- Redis (cache + rate limits) ---
REDIS_PASSWORD=change-me
AIGW_REDIS_OUTAGE_POLICY=degraded_local  # degraded_local (fail-open) | fail_closed

# --- Control-plane session signing (requires >= 32 bytes) ---
# In production, generate with: openssl rand -hex 32
AUTH_HMAC_SIGNING_KEY=change-me-change-me-change-me-change-me

# --- Billing (Dual processor: Stripe & Razorpay) ---
AIGW_BILLING_ENABLED=true
AIGW_BILLING_MODE=test
AIGW_BILLING_PROVIDER=dual
AIGW_BILLING_CURRENCY=usd
AIGW_BILLING_STRIPE_SECRET_KEY=sk_test_placeholder_key_for_testing
AIGW_BILLING_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_for_testing
AIGW_BILLING_STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_for_testing
AIGW_BILLING_RAZORPAY_KEY_ID=rzp_test_placeholder_id
AIGW_BILLING_RAZORPAY_KEY_SECRET=placeholder_secret_for_testing
AIGW_BILLING_RAZORPAY_WEBHOOK_SECRET=whsec_placeholder_secret_for_testing