# AI Governance — backend environment template
#
# Copy to backend/.env for local development (the loader makes .env optional,
# so production runs on real env vars). Every variable maps 1:1 to the typed
# config in backend/internal/platform/config/config.go.
#
# NEVER commit a real .env. Secrets below are obviously-fake placeholders.

# --- Server (shared by gateway, control-api, worker) ---
AIGW_SERVER_ADDR=:8080                 # per-process override in the Makefile dev targets
AIGW_SERVER_READ_HEADER_TIMEOUT=10s
AIGW_SERVER_REQUEST_TIMEOUT=30s        # 0 disables the per-request deadline (gateway once streaming)
AIGW_SERVER_SHUTDOWN_TIMEOUT=10s

# --- Database (control plane; `make dev-up` runs Postgres in docker compose) ---
AIGW_DATABASE_ENABLED=true
AIGW_DATABASE_URL=postgres://gateway:gateway@localhost:5432/ai_gateway?sslmode=disable
AIGW_DATABASE_MAX_OPEN_CONNS=20
AIGW_DATABASE_MAX_IDLE_CONNS=10
AIGW_DATABASE_CONN_MAX_LIFETIME=5m
AIGW_DATABASE_CONNECT_TIMEOUT=5s

# --- Redis (cache + rate limits; gateway milestone) ---
AIGW_REDIS_ENABLED=false            # flip to true once the Redis milestone lands
AIGW_REDIS_ADDR=localhost:6379
AIGW_REDIS_PASSWORD=change-me       # keep in sync with deploy/compose/.env REDIS_PASSWORD
AIGW_REDIS_DB=0

# --- Event bus (outbox; worker-heavy flows) ---
AIGW_EVENTBUS_ENABLED=true
AIGW_EVENTBUS_KIND=inmemory          # inmemory runs in-process; nats is provisioned in compose but not yet built
AIGW_EVENTBUS_URL=nats://localhost:4222

# --- Provider pass-through knobs (provider milestone) ---
AIGW_PROVIDER_REQUEST_TIMEOUT=2m
AIGW_PROVIDER_DEFAULT_MAX_RETRIES=0

# --- Secrets location (NEVER the values themselves) ---
AIGW_SECRETS_PROVIDER=env              # env | vault | aws
AIGW_SECRETS_FILE=./data/secrets.json  # local encrypted store (provider=env)
# AIGW_SECRETS_KEY=                    # hex 32-byte AES key; empty = generate <FILE>.key (0600)
# AIGW_SECRETS_URL=                    # required when provider=vault

# --- Auth (control plane; auth milestone) ---
AIGW_AUTH_JWT_ISSUER=ai-governance
AIGW_AUTH_JWT_TTL=24h
AIGW_AUTH_SESSION_TTL=12h
AIGW_AUTH_HMAC_SIGNING_KEY=change-me-change-me-change-me-change-me  # required by control-api when DB enabled; >= 32 bytes
# AIGW_AUTH_HMAC_PREVIOUS_KEYS=change-me-two,change-me-three   # rotation: prior 32-byte keys, comma-separated
AIGW_AUTH_SESSION_COOKIE_NAME=session  # cookie name; empty = browser sessions disabled
AIGW_AUTH_SESSION_COOKIE_SECURE=false  # require HTTPS for session cookies
AIGW_AUTH_CSRF_ENABLED=false           # double-submit CSRF for cookie-authenticated mutations
AIGW_AUTH_DEV_LOGIN_ENABLED=true      # dev-only: POST /v1/auth/dev-login

# --- Billing ---
AIGW_BILLING_ENABLED=false
AIGW_BILLING_PROVIDER=none
AIGW_BILLING_CURRENCY=usd

# --- Observability ---
AIGW_OBSERVABILITY_LOG_LEVEL=info      # debug | info | warn | error
AIGW_OBSERVABILITY_LOG_FORMAT=json     # json | text
# AIGW_OBSERVABILITY_SERVICE_NAME=gateway
# AIGW_OBSERVABILITY_OTLP_ENDPOINT=     # empty = tracing disabled
AIGW_OBSERVABILITY_METRICS_ENABLED=false

# --- Security ---
# AIGW_SECURITY_CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
AIGW_SECURITY_TRUST_PROXY=false
AIGW_SECURITY_REQUEST_ID_HEADER=X-Request-Id

# --- Conversations ---
# How much transcript content GET /v1/conversations may return for a
# conversation whose own privacy_state is NULL. A conversation-level
# privacy_state always wins; there is no query parameter to widen this.
# Fail-closed: an unrecognized value is rejected at startup.
#   OFF            no restriction; content is returned
#   METADATA_ONLY  content is never returned (default)
#   PROMPT_ONLY    only system/user messages keep their content
#   FULL_CONTENT   all messages keep their content
AIGW_CONVERSATION_PRIVACY_DEFAULT=METADATA_ONLY