# AI Governance / Sentinel AI Gateway — Root Environment Template
# Copy to .env for local development.
#
# Specific processes can also read backend/.env or deploy/compose/.env.

# --- Environment Mode & Security Guardrails ---
AIGW_ENV=development
AIGW_ALLOW_INSECURE_DEV=true

# --- Server (shared by gateway, control-api, worker) ---
AIGW_SERVER_ADDR=:8080
AIGW_SERVER_READ_HEADER_TIMEOUT=10s
AIGW_SERVER_REQUEST_TIMEOUT=30s
AIGW_SERVER_SHUTDOWN_TIMEOUT=10s

# --- Database ---
AIGW_DATABASE_ENABLED=true
AIGW_DATABASE_URL=postgres://gateway:gateway@localhost:5432/ai_gateway?sslmode=disable
AIGW_DATABASE_MAX_OPEN_CONNS=20
AIGW_DATABASE_MAX_IDLE_CONNS=10
AIGW_DATABASE_CONN_MAX_LIFETIME=5m
AIGW_DATABASE_CONNECT_TIMEOUT=5s

# --- Redis ---
AIGW_REDIS_ENABLED=true
AIGW_REDIS_ADDR=localhost:6379
AIGW_REDIS_PASSWORD=change-me
AIGW_REDIS_DB=0
AIGW_REDIS_OUTAGE_POLICY=degraded_local  # degraded_local (fail-open) | fail_closed

# --- Event bus ---
AIGW_EVENTBUS_ENABLED=true
AIGW_EVENTBUS_KIND=nats
AIGW_EVENTBUS_URL=nats://localhost:4222

# --- Provider pass-through knobs ---
AIGW_PROVIDER_REQUEST_TIMEOUT=2m
AIGW_PROVIDER_DEFAULT_MAX_RETRIES=0

# --- Secrets store ---
AIGW_SECRETS_PROVIDER=env
AIGW_SECRETS_FILE=./backend/data/secrets.json

# --- Auth ---
AIGW_AUTH_JWT_ISSUER=ai-governance
AIGW_AUTH_JWT_TTL=24h
AIGW_AUTH_SESSION_TTL=12h
AIGW_AUTH_HMAC_SIGNING_KEY=change-me-change-me-change-me-change-me
AIGW_AUTH_SESSION_COOKIE_NAME=session
AIGW_AUTH_SESSION_COOKIE_SECURE=false
AIGW_AUTH_CSRF_ENABLED=false
AIGW_AUTH_DEV_LOGIN_ENABLED=true

# --- Billing (Dual processor: Stripe & Razorpay) ---
AIGW_BILLING_ENABLED=true
AIGW_BILLING_PROVIDER=dual              # dual | stripe | razorpay | none
AIGW_BILLING_CURRENCY=usd

# Stripe credentials (test mode)
AIGW_BILLING_STRIPE_SECRET_KEY=sk_test_placeholder_key_for_testing
AIGW_BILLING_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_for_testing
AIGW_BILLING_STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_for_testing

# Razorpay credentials (test mode)
AIGW_BILLING_RAZORPAY_KEY_ID=rzp_test_placeholder_id
AIGW_BILLING_RAZORPAY_KEY_SECRET=placeholder_secret_for_testing
AIGW_BILLING_RAZORPAY_WEBHOOK_SECRET=whsec_placeholder_secret_for_testing

# --- Observability ---
AIGW_OBSERVABILITY_LOG_LEVEL=info
AIGW_OBSERVABILITY_LOG_FORMAT=json
AIGW_OBSERVABILITY_METRICS_ENABLED=false
