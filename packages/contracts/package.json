{
  "name": "@ai-governance/contracts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Generated TypeScript types from the OpenAPI contract (backend/api/openapi/openapi.yaml)",
  "exports": {
    ".": "./src/generated.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../backend/api/openapi/openapi.yaml -o src/generated.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.5.2",
    "typescript": "^5.7.3"
  }
}