{
  "name": "ai-governance-saas",
  "private": true,
  "version": "0.0.0",
  "description": "AI Governance SaaS \u2014 monorepo (Next.js web + Go backend + shared TS packages)",
  "workspaces": [
    "app",
    "admin",
    "packages/*"
  ],
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "npm run generate --workspace=@ai-governance/contracts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "next": "^16.3.7"
  }
}
